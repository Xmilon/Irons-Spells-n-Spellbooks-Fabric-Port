{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_true": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "irons_spellbooks:item/twilight_gale_throwing_gui"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "irons_spellbooks:item/twilight_gale_throwing"
      }
    },
    "on_false": {
      "type": "minecraft:select",
      "property": "minecraft:display_context",
      "cases": [
        {
          "when": [
            "gui"
          ],
          "model": {
            "type": "minecraft:model",
            "model": "irons_spellbooks:item/twilight_gale_gui"
          }
        }
      ],
      "fallback": {
        "type": "minecraft:model",
        "model": "irons_spellbooks:item/twilight_gale"
      }
    }
  }
}
