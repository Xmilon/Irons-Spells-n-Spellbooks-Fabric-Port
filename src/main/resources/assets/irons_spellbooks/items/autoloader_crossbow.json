{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:charge_type",
    "cases": [
      {
        "when": "arrow",
        "model": {
          "type": "minecraft:model",
          "model": "irons_spellbooks:item/autoloader_crossbow_arrow"
        }
      },
      {
        "when": "rocket",
        "model": {
          "type": "minecraft:model",
          "model": "irons_spellbooks:item/autoloader_crossbow_firework"
        }
      }
    ],
    "fallback": {
      "on_true": {
        "type": "minecraft:range_dispatch",
        "property": "minecraft:crossbow/pull",
        "entries": [
          {
            "threshold": 0.15,
            "model": {
              "model": "irons_spellbooks:item/autoloader_crossbow_pulling_1",
              "type": "minecraft:model"
            }
          },
          {
            "threshold": 0.3,
            "model": {
              "model": "irons_spellbooks:item/autoloader_crossbow_pulling_2",
              "type": "minecraft:model"
            }
          },
          {
            "threshold": 0.45,
            "model": {
              "model": "irons_spellbooks:item/autoloader_crossbow_pulling_3",
              "type": "minecraft:model"
            }
          },
          {
            "threshold": 0.6,
            "model": {
              "model": "irons_spellbooks:item/autoloader_crossbow_pulling_4",
              "type": "minecraft:model"
            }
          },
          {
            "threshold": 0.75,
            "model": {
              "model": "irons_spellbooks:item/autoloader_crossbow_pulling_5",
              "type": "minecraft:model"
            }
          },
          {
            "threshold": 0.9,
            "model": {
              "model": "irons_spellbooks:item/autoloader_crossbow_pulling_6",
              "type": "minecraft:model"
            }
          }
        ],
        "fallback": {
          "type": "minecraft:model",
          "model": "irons_spellbooks:item/autoloader_crossbow_pulling_0"
        }
      },
      "type": "minecraft:condition",
      "on_false": {
        "type": "minecraft:model",
        "model": "irons_spellbooks:item/autoloader_crossbow"
      },
      "property": "minecraft:using_item"
    }
  }
}
